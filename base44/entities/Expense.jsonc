{
  "name": "Expense",
  "type": "object",
  "properties": {
    "expense_type": {
      "type": "string",
      "enum": [
        "\u0643\u0647\u0631\u0628\u0627\u0621",
        "\u0639\u0645\u0627\u0644\u0629",
        "\u0635\u064a\u0627\u0646\u0629",
        "\u0631\u0648\u0627\u062a\u0628",
        "\u0625\u062f\u0627\u0631\u064a\u0629",
        "\u0637\u0627\u0631\u0626\u0629",
        "\u0628\u0646\u0643\u064a\u0629",
        "\u0623\u062e\u0631\u0649"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0635\u0631\u0648\u0641"
    },
    "amount": {
      "type": "number",
      "description": "\u0627\u0644\u0642\u064a\u0645\u0629"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "\u0646\u0642\u062f\u064a",
        "\u0628\u0646\u0643"
      ],
      "description": "\u0648\u0633\u064a\u0644\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "description": {
      "type": "string",
      "description": "\u0627\u0644\u0648\u0635\u0641"
    },
    "expense_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0635\u0631\u0648\u0641"
    },
    "edited_by": {
      "type": "string",
      "description": "\u0622\u062e\u0631 \u0645\u0646 \u0642\u0627\u0645 \u0628\u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    }
  },
  "required": [
    "expense_type",
    "amount",
    "payment_method",
    "expense_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}