{
  "name": "Booking",
  "type": "object",
  "properties": {
    "booking_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u062d\u062c\u0632"
    },
    "voucher_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0633\u0646\u062f \u0627\u0644\u062f\u0641\u062a\u0631\u064a"
    },
    "customer_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u062c\u0648\u0627\u0644 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629"
    },
    "event_date_hijri": {
      "type": "string",
      "description": "\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0647\u062c\u0631\u064a \u0644\u0644\u0645\u0646\u0627\u0633\u0628\u0629"
    },
    "hall_section": {
      "type": "string",
      "enum": [
        "\u0631\u062c\u0627\u0644 \u0641\u0642\u0637",
        "\u0646\u0633\u0627\u0621 \u0641\u0642\u0637",
        "\u0631\u062c\u0627\u0644 \u0648\u0646\u0633\u0627\u0621"
      ],
      "description": "\u0642\u0633\u0645 \u0627\u0644\u0642\u0627\u0639\u0629"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "\u0632\u0648\u0627\u062c",
        "\u0627\u062c\u062a\u0645\u0627\u0639",
        "\u0645\u0646\u0627\u0633\u0628\u0629 \u0623\u062e\u0631\u0649"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "\u062e\u062f\u0645\u0627\u062a \u0643\u0627\u0645\u0644\u0629",
        "\u062e\u062f\u0645\u0627\u062a \u062c\u0632\u0626\u064a\u0629",
        "\u0628\u062f\u0648\u0646 \u062e\u062f\u0645\u0627\u062a"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062e\u062f\u0645\u0627\u062a"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0645\u0624\u0643\u062f",
        "\u0645\u0639\u0644\u0642",
        "\u0645\u0644\u063a\u064a"
      ],
      "default": "\u0645\u0639\u0644\u0642",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u062c\u0632"
    },
    "items": {
      "type": "array",
      "description": "\u0628\u0646\u0648\u062f \u0627\u0644\u062d\u062c\u0632",
      "items": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "total_amount": {
      "type": "number",
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0628\u0646\u0648\u062f"
    },
    "discount": {
      "type": "number",
      "description": "\u0627\u0644\u062e\u0635\u0645"
    },
    "final_amount": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0646\u0647\u0627\u0626\u064a"
    },
    "paid_amount": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u062f\u0641\u0648\u0639"
    },
    "remaining_amount": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u062a\u0628\u0642\u064a"
    },
    "initial_payment_amount": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0633\u062f\u062f \u0639\u0646\u062f \u0627\u0644\u062d\u062c\u0632"
    },
    "initial_payment_method": {
      "type": "string",
      "enum": [
        "\u0646\u0642\u062f\u064a",
        "\u062a\u062d\u0648\u064a\u0644 \u0628\u0646\u0643\u064a"
      ],
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0633\u062f\u0627\u062f \u0639\u0646\u062f \u0627\u0644\u062d\u062c\u0632"
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "event_date",
    "event_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}